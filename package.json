{
  "name": "agent-share",
  "version": "0.1.0",
  "description": "Share coding-agent session transcripts (Claude Code, pi) with redaction, share modes, and a static viewer",
  "type": "module",
  "bin": { "agent-share": "./dist/cli.js" },
  "files": ["dist", "viewer/dist", "integrations", "README.md"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json && node viewer/build.mjs",
    "build:viewer": "node viewer/build.mjs",
    "prepack": "npm run build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p viewer/tsconfig.json",
    "start": "tsx src/cli.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@sanity-labs/secret-scan": "^1.1.0",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "dompurify": "^3.4.0",
    "esbuild": "^0.28.0",
    "marked": "^18.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
