// Static-assets-only Worker: serves viewer/dist (the landing page at /, the viewer at
// /s/) with no Worker code, no backend and no bindings. `npm run deploy` publishes it to
// https://<name>.<your-subdomain>.workers.dev; point a custom domain at it in the
// Cloudflare dashboard if you want one (e.g. overshare.link).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "overshare-viewer",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./viewer/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
